# Copy this file to .env.local and fill in your own Supabase project values.
# .env.local is already git-ignored (see .gitignore) — never commit your real keys.
#
# Find these in your Supabase project: Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Admin toggle (Daily Docket) ---------------------------------------
# Server-only. Find this in Supabase: Project Settings -> API -> service_role
# key. It bypasses RLS, so it's only ever used from Route Handlers, never
# sent to the browser. Do NOT add a NEXT_PUBLIC_ prefix to this one.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. Any long random string you pick — this is the real session
# secret. The 9-6-3-1 keypad pattern on the tic-tac-toe board is just the
# visible trigger; this value is what actually gates admin writes.
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Optional. Overrides the keypad unlock pattern (default 9631) without
# touching code. Board numbering is 1-9, top-left to bottom-right.
ADMIN_SEQUENCE=9631

# --- AI assistant (Tip Line chat widget) --------------------------------
# Server-only. From console.groq.com -> API Keys. Powers the chat backend
# once it's wired up (not yet — ChatWidget.tsx is UI-only for now). Do NOT
# add a NEXT_PUBLIC_ prefix: it must only ever be read inside a Route
# Handler, never sent to the browser.
GROQ_API_KEY=your-groq-api-key
