# Copy this file to .env.local and fill in your own Supabase project values.
# .env.local is already git-ignored (see .gitignore) — never commit your real keys.
#
# Find these in your Supabase project: Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
